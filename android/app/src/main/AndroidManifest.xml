<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!--
      Both are merged in by dependencies (MediaPipe's optional model downloader and CameraX). This
      app has no business asking for either: the model bundles ship in assets/ and nothing here
      talks to a network. It points a camera at a child, so an unexplained INTERNET permission is
      not a cosmetic issue — it is the difference between a claim that footage stays on the device
      and a claim that it could not leave even if something tried.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:label="remapy"
        android:supportsRtl="true"
        android:theme="@style/Theme.Remapy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Remapy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
